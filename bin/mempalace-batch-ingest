#!/usr/bin/env python3
"""mempalace-batch-ingest — resumable, indexed backfill of transcripts into the
cluster palace.

Wraps `mempalace-remote mine` with a durable per-file INDEX so the backfill is
stop/resume-able and snapshot-pinnable:

  - Discovers transcript files under --source matching --glob, records each in a
    JSON index as `pending`.
  - Processes them in batches of --batch: stages a batch's files into a temp dir
    (the miner skips symlinks, so files are copied), runs one
    `mempalace-remote mine <batchdir> --wing <wing>`, and on success marks every
    file in that batch `done` (with drawer count + timestamp).
  - The index is rewritten ATOMICALLY (tmp + os.replace) after each batch, so it
    is always a consistent snapshot of progress.

Stop/resume: Ctrl-C / SIGTERM between batches exits cleanly; a kill mid-batch
leaves that batch `pending` (drawers are content-hashed → re-mining is a no-op).
Re-running resumes from the index, skipping `done` files WITHOUT re-parsing them.

Snapshot-pin: the index file is the snapshot. `cp <index> <index>.pin-<label>` to
pin a point; resume a pin with `--index <index>.pin-<label>`.

Usage:
  mempalace-batch-ingest --wing claude_history          # start/resume full backfill
  mempalace-batch-ingest --wing claude_history --status # show progress + ETA, exit
  mempalace-batch-ingest --wing claude_history --limit 200   # process at most 200 files this run
  mempalace-batch-ingest --reset                        # clear the index

Options:
  --source DIR    transcript root (default ~/.claude/projects)
  --glob PAT      filename glob (default *.jsonl)
  --wing NAME     target wing (default claude_history)
  --index PATH    index file (default ~/.mempalace/backfill-index.json)
  --batch N       files per mine invocation (default 50; bigger = less model-load
                  overhead, coarser checkpoints)
  --limit N       stop after N files processed this run (0 = until done)
  --embed-device  GPU | CPU (default CPU — stable; GPU OOMs on the iGPU)
  --remote PATH   path to mempalace-remote (default: sibling of this script)
  --status        print done/pending/total + ETA and exit
  --reset         delete the index and exit
"""

from __future__ import annotations

import argparse
import os
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# JSON kept human-diffable; index is per-file (thousands), not per-drawer.
import json

_STOP = False


def _handle_stop(signum, frame):
    global _STOP
    _STOP = True
    print(f"\n[batch-ingest] signal {signum} received — finishing current batch, then stopping.", flush=True)


def load_index(path: Path) -> dict:
    if path.exists():
        return json.loads(path.read_text())
    return {"version": 1, "files": {}}


def save_index(path: Path, idx: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(json.dumps(idx, indent=0))
    os.replace(tmp, path)  # atomic


def discover(source: Path, glob: str, idx: dict) -> int:
    """Add any not-yet-indexed files as pending. Returns count added."""
    added = 0
    files = idx.setdefault("files", {})
    for p in sorted(source.rglob(glob)):
        key = str(p.resolve())
        if key not in files:
            files[key] = {"status": "pending", "mtime": p.stat().st_mtime}
            added += 1
    return added


def counts(idx: dict) -> tuple[int, int]:
    done = sum(1 for f in idx["files"].values() if f["status"] == "done")
    return done, len(idx["files"])


def status(idx: dict) -> None:
    done, total = counts(idx)
    drawers = sum(f.get("drawers", 0) for f in idx["files"].values() if f["status"] == "done")
    print(f"index: {done}/{total} files done ({total - done} pending); {drawers} drawers filed")


def main() -> int:
    ap = argparse.ArgumentParser(prog="mempalace-batch-ingest")
    ap.add_argument("--source", default=os.path.expanduser("~/.claude/projects"))
    ap.add_argument("--glob", default="*.jsonl")
    ap.add_argument("--wing", default="claude_history")
    ap.add_argument("--index", default=os.path.expanduser("~/.mempalace/backfill-index.json"))
    ap.add_argument("--batch", type=int, default=50)
    ap.add_argument("--limit", type=int, default=0)
    ap.add_argument("--embed-device", default="CPU", choices=["CPU", "GPU"])
    ap.add_argument("--remote", default=str(Path(__file__).resolve().parent / "mempalace-remote"))
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--reset", action="store_true")
    args = ap.parse_args()

    index_path = Path(args.index)

    if args.reset:
        if index_path.exists():
            index_path.unlink()
            print(f"removed {index_path}")
        else:
            print("no index to remove")
        return 0

    idx = load_index(index_path)
    if args.status:
        status(idx)
        return 0

    added = discover(Path(args.source), args.glob, idx)
    if added:
        print(f"[batch-ingest] discovered {added} new files under {args.source}/{args.glob}")
        save_index(index_path, idx)

    pending = [k for k, f in idx["files"].items() if f["status"] != "done"]
    if not pending:
        print("[batch-ingest] nothing to do — all files done.")
        status(idx)
        return 0

    signal.signal(signal.SIGINT, _handle_stop)
    signal.signal(signal.SIGTERM, _handle_stop)

    done0, total = counts(idx)
    print(f"[batch-ingest] {len(pending)} pending of {total}; wing={args.wing} batch={args.batch} embed={args.embed_device}")
    env = dict(os.environ)
    env["MEMPALACE_EMBED_MODE"] = "client"
    env["MEMPALACE_EMBED_OPENVINO_DEVICE"] = args.embed_device

    processed_this_run = 0
    t_start = time.time()
    for i in range(0, len(pending), args.batch):
        if _STOP:
            break
        if args.limit and processed_this_run >= args.limit:
            print(f"[batch-ingest] reached --limit {args.limit} this run; stopping.")
            break
        batch = pending[i : i + args.batch]
        staging = Path(tempfile.mkdtemp(prefix="mp-batch-"))
        try:
            for src in batch:
                # Copy (miner skips symlinks). Flatten name; collisions improbable
                # across transcript UUIDs, and a clash just re-files idempotently.
                shutil.copy2(src, staging / Path(src).name)
            r = subprocess.run(
                [args.remote, "mine", str(staging), "--mode", "convos", "--wing", args.wing],
                env=env,
                capture_output=True,
                text=True,
            )
            drawers = 0
            for line in r.stdout.splitlines():
                s = line.strip()
                if s.startswith("Drawers filed:"):
                    try:
                        drawers = int(s.split(":")[1])
                    except (ValueError, IndexError):
                        pass
            if r.returncode != 0:
                print(f"[batch-ingest] batch {i // args.batch} FAILED (rc={r.returncode}); leaving pending. stderr tail:")
                print("  " + "\n  ".join(r.stderr.splitlines()[-4:]))
                # do not mark done; stop to avoid hammering a broken state
                break
            ts = time.time()
            per = max(drawers // max(len(batch), 1), 0)
            for src in batch:
                idx["files"][src] = {
                    "status": "done",
                    "mtime": idx["files"][src].get("mtime"),
                    "drawers": per,
                    "ts": ts,
                }
            save_index(index_path, idx)  # atomic checkpoint
            processed_this_run += len(batch)
            done, _ = counts(idx)
            rate = processed_this_run / max(time.time() - t_start, 1)
            remaining = total - done
            eta_h = remaining / rate / 3600 if rate else 0
            print(
                f"[batch-ingest] batch {i // args.batch}: +{len(batch)} files, ~{drawers} drawers | "
                f"{done}/{total} done | {rate * 60:.1f} files/min | ETA {eta_h:.1f}h",
                flush=True,
            )
        finally:
            shutil.rmtree(staging, ignore_errors=True)

    done, total = counts(idx)
    print(f"[batch-ingest] stopped: {done}/{total} files done ({total - done} pending). Re-run to resume.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
